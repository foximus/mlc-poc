  "schema": [
    {
      "name": "P01",
      "label": "Fecha de la entrevista",
      "type": "text",
      "pilar": "Operativo"
    },
    {
      "name": "P02",
      "label": "Nombre del establecimiento de salud",
      "type": "text",
      "pilar": "Operativo"
    },
    {
      "name": "P03",
      "label": "Áreas del establecimiento de salud",
      "type": "select_multiple list_P03",
      "pilar": "Operativo"
    },
    {
      "name": "P04",
      "label": "Cargo de la persona entrevistada",
      "type": "select_one list_P04",
      "pilar": "Operativo"
    },
    {
      "name": "P05",
      "label": "¿Poblaciones clave que atiende el servicio?",
      "type": "select_multiple list_P05",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P06",
      "label": "¿Cuántas personas con VIH reciben atención en este establecimiento de salud?",
      "type": "text",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P07",
      "label": "¿Posee datos desagregados por género, orientación sexual, identidad de género?",
      "type": "select_one list_P07",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P08",
      "label": "¿Cuenta con protocolos, guías y manuales para cumplir las funciones de atención a personas que reciben atención para el VIH?",
      "type": "select_one list_P08",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P09",
      "label": "¿Conocen la Estrategia de Atención Integral y Diferenciada en Salud para las Personas Trans en Guatemala ?",
      "type": "select_one list_P09",
      "pilar": "Adecuación"
    },
    {
      "name": "P10",
      "label": "¿Ofertan métodos anticonceptivos en este establecimiento de salud?",
      "type": "select_one list_P10",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P11",
      "label": "¿Ofertan condones masculinos en este establecimiento de salud?",
      "type": "select_one list_P11",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P12",
      "label": "¿Ofertan condones femeninos en este establecimiento de salud?",
      "type": "select_one list_P12",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P13",
      "label": "¿Ofertan lubricantes en este establecimiento de salud?",
      "type": "select_one list_P13",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P14",
      "label": "¿El establecimiento de salud cuenta con pruebas rápidas de VIH disponibles diariamente?",
      "type": "select_one list_P14",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P15",
      "label": "En los últimos 3 meses, ¿cuántas pruebas rápidas de VIH se realizaron en promedio por semana?",
      "type": "text",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P16",
      "label": "¿Cuál es el tiempo promedio entre la toma de la prueba rápida y la entrega del resultado? (en días)",
      "type": "text",
      "pilar": "Accesibilidad"
    },
    {
      "name": "P17",
      "label": "¿Cuál es el tiempo promedio entre un resultado reactivo y la confirmación del  diagnóstico?",
      "type": "text",
      "pilar": "Accesibilidad"
    },
    {
      "name": "P18",
      "label": "¿Existe un protocolo formal para la vinculación de personas con diagnóstico reactivo/confirmado al establecimiento de salud?",
      "type": "select_one list_P18",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P19",
      "label": "¿Qué porcentaje estimado de personas con diagnóstico confirmado inicia su primera consulta médica en un plazo ≤7 días?",
      "type": "select_one list_P19",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P20",
      "label": "¿Se asigna un gestor/a, consejero/a o navegador/a para acompañar a la persona desde el diagnóstico hasta la primera consulta?",
      "type": "select_one list_P20",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P21",
      "label": "¿Se realiza seguimiento telefónico o domiciliario a las personas que no asisten a su primera cita después del diagnóstico?",
      "type": "select_one list_P21",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P22",
      "label": "En los últimos 3 meses, ¿cuántas personas con diagnóstico confirmado no lograron vincularse al establecimiento de salud (no asistieron a ninguna consulta)?",
      "type": "text",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P23",
      "label": "¿Cuál es el sistema donde registra los datos de las personas usuarias?",
      "type": "select_multiple list_P23",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P24",
      "label": "¿Cuál es la tasa de retención a 12 meses (pacientes que continúan activos después de 1 año de ingreso)?",
      "type": "text",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P25",
      "label": "¿Se define como \"pérdida en seguimiento\" a la persona que no asiste a consulta en un período de?",
      "type": "select_one list_P25",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P26",
      "label": "¿Se realizan acciones de búsqueda activa de personas con pérdida en seguimiento?",
      "type": "select_one list_P26",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P27",
      "label": "¿Con qué frecuencia se realiza la auditoría de la base de datos para identificar citas pendientes o pacientes inactivos?",
      "type": "select_one list_P27",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P28",
      "label": "¿Existe un sistema de recordatorio de citas (llamadas, mensajes de texto, etc.)?",
      "type": "select_one list_P28",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P29",
      "label": "¿Cuál es el tiempo promedio para la atención de una consulta médica en el establecimiento de salud (minutos)?",
      "type": "text",
      "pilar": "Aceptabilidad"
    },
    {
      "name": "P30",
      "label": "¿El establecimiento de salud cuenta con disponibilidad continua de TAR (sin desabastecimiento en los últimos 3 meses)?",
      "type": "select_one list_P30",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P31",
      "label": "¿Se entrega TAR para al menos 30 días y un máximo de 90 días a los pacientes estables?",
      "type": "select_one list_P31",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P32",
      "label": "¿Se realiza evaluación de adherencia en cada consulta con método validado (autoreporte, conteo de pastillas, etc.)?",
      "type": "select_one list_P32",
      "pilar": "Aceptabilidad"
    },
    {
      "name": "P33",
      "label": "¿El establecimiento de salud ofrece consejería en adherencia al inicio del tratamiento y ante dificultades detectadas?",
      "type": "select_one list_P33",
      "pilar": "Aceptabilidad"
    },
    {
      "name": "P34",
      "label": "¿Existe un registro de la proporción de pacientes con carga viral suprimida (<1000 copias/mL) en los últimos 6 meses?",
      "type": "select_one list_P34",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P35",
      "label": "¿Cuál es el porcentaje de pacientes en TAR con carga viral suprimida en la última medición?",
      "type": "text",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P36",
      "label": "¿Se realiza carga viral a todos los pacientes en TAR con la frecuencia establecida por normativa (cada 6-12 meses)?",
      "type": "select_one list_P36",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P37",
      "label": "¿Cuál es el tiempo promedio entre la toma de muestra para carga viral y la entrega del resultado al médico tratante? (en días)",
      "type": "integer",
      "pilar": "Accesibilidad"
    },
    {
      "name": "P38",
      "label": "¿Se realiza un análisis de la cascada de atención institucional (diagnosticados, vinculados, en TAR, suprimidos) al menos una vez al año?",
      "type": "select_one list_P38",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P39",
      "label": "¿Se realizan reuniones clínicas de análisis de casos con falla virológica para ajustar estrategias?",
      "type": "select_one list_P39",
      "pilar": "Cascada de atención"
    },
    {
      "name": "P40",
      "label": "¿Realizan pruebas de laboratorio a las personas que reciben atención para el VIH?",
      "type": "select_one list_P40",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P41",
      "label": "¿Cuántas pruebas realizan de estos tipos?",
      "type": "text",
      "pilar": "Disponibilidad"
    },
    {
      "name": "P42",
      "label": "La señalización interna es visible y permite ubicar fácilmente los servicios",
      "type": "select_one list_P42",
      "pilar": "Accesibilidad"
    },
    {
      "name": "P43",
      "label": "Existen letreros o indicaciones que guían al usuario hacia consulta, toma de muestras y farmacia",
      "type": "select_one list_P43",
      "pilar": "Accesibilidad"
    },
    {
      "name": "P44",
      "label": "Las consultas y consejerías se realizan en espacios cerrados que impiden ser escuchados por terceros",
      "type": "select_one list_P44",
      "pilar": "Aceptabilidad"
    },
    {
      "name": "P45",
      "label": "Los registros clínicos y resultados se manejan en áreas restringidas al personal autorizado",
      "type": "select_one list_P45",
      "pilar": "Aceptabilidad"
    },
    {
      "name": "P46",
      "label": "Las áreas de atención cuentan con separación física (biombo, puerta, cubículo) que garantiza privacidad durante el procedimiento",
      "type": "select_one list_P46",
      "pilar": "Aceptabilidad"
    },
    {
      "name": "P47",
      "label": "Las instalaciones se perciben seguras para usuarios y personal (iluminación exterior, accesos controlados)",
      "type": "select_one list_P47",
      "pilar": "Aceptabilidad"
    },
    {
      "name": "P48",
      "label": "El área de espera cuenta con capacidad suficiente para la demanda habitual",
      "type": "select_one list_P48",
      "pilar": "Aceptabilidad"
    },
    {
      "name": "P49",
      "label": "El área de espera dispone de asientos en buen estado y distribución ordenada",
      "type": "select_one list_P49",
      "pilar": "Aceptabilidad"
    },
    {
      "name": "P50",
      "label": "¿Sabe si en este centro se implementa el protocolo de atención a las personas trans?",
      "type": "select_one list_P50",
      "pilar": "Adecuación"
    },
    {
      "name": "P51",
      "label": "¿Cuántas capacitaciones se han realizado en los últimos 6 meses sobre el protocolo de atención a personas trans?",
      "type": "integer",
      "pilar": "Adecuación"
    }
  ],
